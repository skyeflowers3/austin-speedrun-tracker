# Org-owned Supabase project (Project Settings → API)
# Create under the GT org, add a second owner before handoff.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Marketing site origin used in Tracker "Share link" / invite URLs.
# Local: http://127.0.0.1:8000 (default if unset)
# Deploy: VITE_PUBLIC_SITE_URL=https://speedrun.gt.school
VITE_PUBLIC_SITE_URL=http://127.0.0.1:8000
